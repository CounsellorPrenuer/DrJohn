# PostgreSQL connection string (use pooled connection for Vercel, e.g. Neon/Supabase pgbouncer URL)
DATABASE_URL="postgresql://user:password@localhost:5432/ospa?schema=public"
# Direct (non-pooled) connection, required by Prisma migrate when using a pooler
DIRECT_URL="postgresql://user:password@localhost:5432/ospa?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional secondary provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
