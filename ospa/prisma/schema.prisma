generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  ADMIN
}

enum Factor {
  FACTOR_I_PLANNING
  FACTOR_II_SOCIAL_ADJUSTMENT
  FACTOR_III_SOCIAL_EFFECTIVENESS
  FACTOR_IV_DYNAMIC
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role     @default(CANDIDATE)
  createdAt     DateTime @default(now())

  accounts  Account[]
  sessions  Session[]
  attempts  AssessmentAttempt[]
  feedback  Feedback[]
  auditLogs AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OLQ {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "EI", "COURAGE"
  name        String
  factor      Factor
  description String  @db.Text

  questionLinks QuestionOLQ[]
}

model Module {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String  @db.Text
  order       Int

  questions Question[]
}

model Question {
  id             String   @id @default(cuid())
  moduleId       String
  prompt         String   @db.Text
  type           String   // "likert5" | "scenario" | "forced_choice"
  options        Json?
  isSeedSample   Boolean  @default(false)
  order          Int

  module    Module        @relation(fields: [moduleId], references: [id])
  olqLinks  QuestionOLQ[]
  responses Response[]
}

model QuestionOLQ {
  questionId String
  olqId      String
  weight     Float @default(1.0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  olq      OLQ      @relation(fields: [olqId], references: [id], onDelete: Cascade)

  @@id([questionId, olqId])
}

model AssessmentAttempt {
  id          String        @id @default(cuid())
  userId      String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  scoredAt    DateTime?
  isPaid      Boolean       @default(false)

  user      User        @relation(fields: [userId], references: [id])
  responses Response[]
  report    Report?

  @@index([userId])
}

model Response {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  value      Json     // raw answer (score, choice, text)
  updatedAt  DateTime @updatedAt

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Report {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  olqScores     Json     // { [olqCode]: number }
  factorScores  Json     // { [factor]: number }
  overallScore  Float
  narrative     String   @db.Text
  pdfUrl        String?
  createdAt     DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  attemptId String?
  category  String   // "bug" | "content" | "scoring" | "general"
  message   String   @db.Text
  rating    Int?     // optional 1-5 satisfaction rating
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}
